# ALIAS Configuration
# Copy to .env and edit as needed. All values are optional — defaults are shown.

ALIAS_HOST=127.0.0.1
ALIAS_PORT=8000
ALIAS_DB_PATH=./alias.db
ALIAS_LOG_LEVEL=INFO

# Security limits
ALIAS_MAX_QUERY_DEPTH=10
ALIAS_MAX_COMPLEXITY=1000
ALIAS_MAX_BATCH_OPERATIONS=10
ALIAS_MAX_RESPONSE_SIZE=1048576

# Experiment limits
ALIAS_MAX_CONCURRENT_EXPERIMENTS=3
ALIAS_EXPERIMENT_TIMEOUT_SECONDS=30

# Development
ALIAS_DEBUG=false
